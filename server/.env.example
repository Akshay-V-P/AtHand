# AtHand Server Environment Configuration Template
# Copy this file to .env in the server directory and populate with your credentials.

# Application & Networking
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database & Cache
MONGO_URL=mongodb://localhost:27017/athand
REDIS_URL=redis://localhost:6379

# Password Security
HASH_SALT=10

# JSON Web Token Secrets & Expiration
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES=7d
JWT_REGISTRATION_SECRET=your_jwt_registration_secret_here
JWT_REGISTRATION_EXPIRES=15m

# AWS S3 Cloud Storage
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Nodemailer / Email Service (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Authentication Links
RESET_LINK=http://localhost:5173/reset-password?token=

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
